{
  "name": "notifications-api-typescript",
  "private": true,
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test --test-timeout=15000 \"src/**/*.test.ts\"",
    "verify": "npm run typecheck && npm test",
    "prepare": "node scripts/enable-hooks.mjs"
  },
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
